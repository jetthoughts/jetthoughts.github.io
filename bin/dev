#!/usr/bin/env bash
# Hugo dev server + LinkedIn review-board sidecar (bin/li-review).
# PORT picks the server port (default 1313 for humans; AI sessions set their
# own to avoid collisions). The sidecar always rides PORT+1000.
set -euo pipefail

# postcss.config.js checks this to skip PurgeCSS/cssnano in dev; Hugo doesn't
# export it to Node children on its own.
export HUGO_ENVIRONMENT="development"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PATH="$SCRIPT_DIR/../node_modules/.bin:$PATH"
export PATH

PORT="${PORT:-1313}"
echo "🚀 Hugo dev: http://localhost:$PORT (board sidecar on $((PORT + 1000)))"

PORT=$((PORT + 1000)) "$SCRIPT_DIR/li-review" & LI_PID=$!
# Hugo runs in the background so INT/TERM sent to this pid reach it via the
# traps (a foreground child would defer traps until it exits on its own).
hugo server --bind 0.0.0.0 --port "$PORT" --renderToMemory --noHTTPCache "$@" & HUGO_PID=$!

cleanup() { kill "$LI_PID" "$HUGO_PID" 2>/dev/null || true; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
wait "$HUGO_PID"
