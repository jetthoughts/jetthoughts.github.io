#!/usr/bin/env bash
# Install the pinned visual-test rendering stack on bare-metal Linux, so a
# host run matches the .dev/Dockerfile image that records the
# test/fixtures/screenshots/linux/ baselines.
#
# Stack = Chrome for Testing + matching chromedriver (version in
# .dev/cft-version), the deterministic fontconfig (.dev/fonts.conf), and the
# same font packages. After running:
#
#   eval "$(bin/setup-test-env --print-env)"
#   bin/rake test:critical
#
# --print-env  only emit the export lines for eval (no installs)

set -euo pipefail
cd "$(dirname "$0")/.."

CFT=$(tr -d '[:space:]' < .dev/cft-version)
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/jt-cft/$CFT"
CHROME="$CACHE/chrome-linux64/chrome"
DRIVER="$CACHE/chromedriver-linux64/chromedriver"

if [ "${1:-}" = "--print-env" ]; then
  echo "export CHROME_BIN=\"$CHROME\""
  echo "export CHROMEDRIVER_PATH=\"$DRIVER\""
  exit 0
fi

if [ "$(uname -s)" != "Linux" ]; then
  echo "setup-test-env targets bare-metal Linux; on macOS use bin/test (macos/ baselines), for the linux/ baselines use bin/dtest." >&2
  exit 1
fi

# 1. Chrome for Testing + chromedriver (pinned)
if [ ! -x "$CHROME" ] || [ ! -x "$DRIVER" ]; then
  echo "==> Downloading Chrome for Testing $CFT to $CACHE"
  mkdir -p "$CACHE" && cd "$CACHE"
  curl -sSLO "https://storage.googleapis.com/chrome-for-testing-public/$CFT/linux64/chrome-linux64.zip"
  curl -sSLO "https://storage.googleapis.com/chrome-for-testing-public/$CFT/linux64/chromedriver-linux64.zip"
  unzip -oq chrome-linux64.zip && unzip -oq chromedriver-linux64.zip
  rm -f chrome-linux64.zip chromedriver-linux64.zip
  cd - >/dev/null
fi
"$CHROME" --version
"$DRIVER" --version

# 2. Fonts + fontconfig (must match the Docker image for comparable pixels)
if type apt-get >/dev/null 2>&1; then
  need=""
  for p in fonts-noto-core fonts-freefont-ttf fonts-dejavu-core fontconfig libvips42; do
    dpkg -s "$p" >/dev/null 2>&1 || need="$need $p"
  done
  if [ -n "$need" ]; then
    echo "==> Installing:$need (sudo may prompt)"
    sudo apt-get install -y --no-install-recommends $need
  fi
else
  echo "WARN: no apt-get - install fonts-noto-core/fonts-freefont-ttf/fonts-dejavu equivalents + libvips manually" >&2
fi

fonts_conf_target="/etc/fonts/local.conf"
if [ -w /etc/fonts ] || [ "$(id -u)" = "0" ]; then
  cp .dev/fonts.conf "$fonts_conf_target"
else
  fonts_conf_target="${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/fonts.conf"
  mkdir -p "$(dirname "$fonts_conf_target")"
  cp .dev/fonts.conf "$fonts_conf_target"
fi
fc-cache -f >/dev/null 2>&1 || true
echo "==> fontconfig installed at $fonts_conf_target"

echo ""
echo "Rendering stack ready. Run tests with:"
echo "  eval \"\$(bin/setup-test-env --print-env)\""
echo "  bin/rake test:critical"
