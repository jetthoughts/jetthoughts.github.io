#!/usr/bin/env ruby
# frozen_string_literal: true
#
# devx (item16 20%-slot): guard the course landing against section-count
# drift. The shuffle2 reference (40.28) is a 4-section page — hero,
# mistakes, module map, dark NOT-cover. Item 16 cut the landing from ~2x
# that height by relocating 4 off-reference sections off the page. This is
# the build-time net that stops them (or new ones) creeping back and
# re-bloating the acquisition surface. The visual suite is hero-fold-scoped
# and can't see below-fold section growth, so a text count is the real net.
#
# Counts body H2s (markdown `## ` + inline `<h2`) on the landing _index.md;
# the hero is frontmatter, not an H2. Budget = the reference's 3 body
# sections (Why this course exists / Module map / What this course does NOT
# cover) + 1 slack.
#
# Report-only default (exit 0 + count). LANDING_PARITY_BLOCK=1 exit 1.
# Usage: bin/check-landing-parity [--self-test]

REPORT_ONLY = ENV.fetch("LANDING_PARITY_BLOCK", "") != "1"
BUDGET = 4
LANDING = "content/course/tech-for-non-technical-founders-2026/_index.md"

def h2_count(text)
  body = text.sub(/\A---\n.*?\n---\n/m, "") # drop frontmatter
  body.scan(/^##\s+\S/).size + body.scan(/<h2[\s>]/).size
end

if ARGV.include?("--self-test")
  ok = h2_count("---\nt: x\n---\n## A\n## B\n<h2>C</h2>\n") == 3
  puts ok ? "self-test: ok" : "self-test: FAIL"
  exit(ok ? 0 : 1)
end

n = h2_count(File.read(LANDING))
if n <= BUDGET
  puts "landing-parity: #{n} body sections (<= #{BUDGET} budget) - matches the reference shape"
  exit 0
end

puts "landing-parity: #{n} body sections exceeds the #{BUDGET} reference budget"
puts "  the shuffle2 reference is a 4-section page; relocate depth content to how-this-course-works/faq"
exit(REPORT_ONLY ? 0 : 1)
